# Backend Configuration
# Port for the Express.js backend server
BACKEND_PORT=3000

# Backend URL (used by frontend to connect to API)
# Development: http://localhost:3000
# Production: Update with your deployed backend URL
BACKEND_URL=http://localhost:3000

# Frontend Configuration
# Vite dev server port (if you want to override default 5173)
# VITE_PORT=5173

# API Base URL for frontend
# This will be used by the frontend to make API calls
VITE_API_BASE_URL=http://localhost:3000

# Environment
NODE_ENV=development
